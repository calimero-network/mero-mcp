#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Add node to PATH
export PATH="/opt/homebrew/bin:$PATH"

# Get the project root directory
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
# Path to CLI script
CLI="$PROJECT_ROOT/bin/mero-cli"

# Run prettier and eslint on staged files
echo "Running pre-commit hook..."
echo "Linting staged files..."

# Check if any TypeScript files are staged
FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "\.ts$" || true)

if [ -n "$FILES" ]; then
  echo "Running prettier and eslint on staged TypeScript files..."
  # Use the CLI wrapper
  $CLI format
  $CLI lint
  
  echo "Running TypeScript type check..."
  # Run TypeScript compiler to check for type errors
  npm run build:check || {
    echo "TypeScript type check failed! Please fix the errors before committing."
    exit 1
  }
  
  git add $FILES
else
  echo "No TypeScript files staged for commit."
fi
