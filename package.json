{
  "name": "@calimero-network/mero-mcp",
  "version": "0.0.0",
  "description": "Stdio MCP server for driving any Calimero application on a local node",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mero-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calimero-network/mero-mcp.git"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "build": "tsc -p tsconfig.build.json",
    "test:bin": "npm run build && node scripts/bin-smoke.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "e2e:cycle": "npm run build && node scripts/e2e-cycle.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@calimero-network/abi-codegen": "^2.0.1",
    "@calimero-network/mero-js": "^19.14.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.6.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "semantic-release": "^25.0.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
